# visible-ia · variables de entorno
# Copia este archivo como .env (PowerShell: Copy-Item .env.example .env) y pega los valores.
# .env está en .gitignore: NUNCA se sube a GitHub. No pegues claves en el chat.

# Entorno activo de la CLI: dev o prod
VISIBLE_IA_ENV=dev

# --- Supabase DEV (Project Settings > API y botón Connect) ---
SUPABASE_URL_DEV=
SUPABASE_ANON_KEY_DEV=
SUPABASE_SERVICE_ROLE_KEY_DEV=
# Cadena de conexión Postgres (Connect > Connection string, con la contraseña de la base)
SUPABASE_DB_URL_DEV=

# --- Supabase PROD ---
SUPABASE_URL_PROD=
SUPABASE_ANON_KEY_PROD=
SUPABASE_SERVICE_ROLE_KEY_PROD=
SUPABASE_DB_URL_PROD=

# --- Cloudflare Pages ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- APIs del motor (se usan desde C3; dejar vacías hasta entonces) ---
OPENAI_API_KEY=
SERPAPI_API_KEY=

# --- Límites (valores por defecto) ---
MONTHLY_BUDGET_USD=10
SERPAPI_MONTHLY_QUOTA=250
